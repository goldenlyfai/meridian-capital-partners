# Meridian Capital Partners — Environment Variables
# Copy to .env and fill in your keys. Never commit .env to git.

# --- REQUIRED ---
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# --- ALPACA (paper trading default) ---
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key

# --- OPTIONAL PREMIUM DATA SOURCES ---
# If set, overrides yfinance for prices / fundamentals
POLYGON_API_KEY=

# If set, enables earnings transcripts + structured financials
FMP_API_KEY=

# If set, enables yield curve / credit spread data (BAMLH0A0HYM2)
FRED_API_KEY=
